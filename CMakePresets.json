{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Ninja (local Qt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYDESK_PRODUCT": "draft",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt;/usr/local/opt/qt"
      }
    },
    {
      "name": "draft-macos-release",
      "displayName": "MyDesk Draft Release (macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/draft-macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYDESK_PRODUCT": "draft",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt;/usr/local/opt/qt"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release (Draft)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless Draft tests (no Qt UI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYDESK_PRODUCT": "draft",
        "MYDESK_BUILD_DESKTOP": "OFF",
        "MYDESK_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "mechanical",
      "displayName": "MyDesk Mechanical (OCCT)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mechanical",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYDESK_PRODUCT": "mechanical",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/opencascade;/usr/local/opt/opencascade"
      }
    },
    {
      "name": "buildings",
      "displayName": "MyDesk Buildings (BIM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/buildings",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYDESK_PRODUCT": "buildings",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "default",
      "displayName": "CI macOS Draft",
      "binaryDir": "${sourceDir}/build/ci"
    },
    {
      "name": "ci-linux",
      "displayName": "CI Linux Draft",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYDESK_PRODUCT": "draft",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows Draft",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYDESK_PRODUCT": "draft",
        "MYDESK_BUILD_DESKTOP": "ON",
        "MYDESK_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "draft-macos-release", "configurePreset": "draft-macos-release" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "mechanical", "configurePreset": "mechanical" },
    { "name": "buildings", "configurePreset": "buildings" },
    { "name": "ci-macos", "configurePreset": "ci-macos" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-windows", "configurePreset": "ci-windows" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true }
    }
  ]
}
